# ============================================
# VoiceFlow Voice Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# cp .env.example .env

# ============================================
# REQUIRED VARIABLES
# ============================================

# LiveKit Configuration
# Get your keys from: https://cloud.livekit.io/ or self-hosted LiveKit
LIVEKIT_URL=wss://your-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Services
# OpenAI - Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Deepgram - Get API key from: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key

# Cartesia - Get API key from: https://dashboard.cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key

# Database
# Supabase - Get credentials from: https://app.supabase.com/
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Server Configuration
PORT=8000  

# Beyond Presence Avatar (Optional)
# Get API key from: https://beyondpresence.ai/
# If not provided, system will use animated fallback avatar
BEY_API_KEY=your_beyond_presence_api_key
BEY_AVATAR_ID=your_avatar_id

# Google Calendar Integration (Optional)
# Get credentials from: https://console.cloud.google.com/
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALENDAR_ID=primary  # Default: "primary"
CALENDAR_TIMEZONE=Asia/Kolkata  # Default: "Asia/Kolkata"
